# DeskOS Production Environment Variables
# Copy this to .env and fill in values

NODE_ENV=production
PORT=4000

# Database (required)
DATABASE_URL=postgresql://deskos:password@localhost:5432/deskos

# JWT secret (required in production — generate a strong random string)
DESKOS_JWT_SECRET=

# Email key (required in production)
DESKOS_EMAIL_KEY=

# Relay secret (required in production)
DESKOS_RELAY_SECRET=

# Public URL (the URL users visit to access the app)
DESKOS_PUBLIC_URL=https://your-app.onrender.com

# Relay WebSocket URL (for remote sessions — can set up later)
DESKOS_RELAY_URL=

# Auto-run migrations on startup (set to 1 for initial deploy)
DESKOS_AUTO_MIGRATE=1

# SMTP (optional — for email notifications)
DESKOS_SMTP_HOST=
DESKOS_SMTP_PORT=587
DESKOS_SMTP_USER=
DESKOS_SMTP_PASS=
DESKOS_SMTP_FROM=

# AI (optional — for AI features)
DESKOS_AI_ENABLED=false
DESKOS_AI_API_KEY=

# VAPID keys (optional — for Web Push notifications)
DESKOS_VAPID_PUBLIC_KEY=
DESKOS_VAPID_PRIVATE_KEY=
DESKOS_VAPID_SUBJECT=mailto:admin@yourdomain.com

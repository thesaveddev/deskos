# ReyDesk Production Environment Variables
# Copy this to .env and fill in values

NODE_ENV=production
PORT=4000

# Database (required)
DATABASE_URL=postgresql://deskos:password@localhost:5432/deskos

# JWT secret (required in production — generate a strong random string)
REYDESK_JWT_SECRET=

# Email key (required in production)
REYDESK_EMAIL_KEY=

# Relay secret (required in production)
REYDESK_RELAY_SECRET=

# Public URL (the URL users visit to access the app)
REYDESK_PUBLIC_URL=https://your-app.onrender.com

# Relay WebSocket URL (for remote sessions — can set up later)
REYDESK_RELAY_URL=

# Auto-run migrations on startup (set to 1 for initial deploy)
REYDESK_AUTO_MIGRATE=1

# SMTP (optional — for email notifications)
REYDESK_SMTP_HOST=
REYDESK_SMTP_PORT=587
REYDESK_SMTP_USER=
REYDESK_SMTP_PASS=
REYDESK_SMTP_FROM=
REYDESK_SMTP_TLS=true
# Use 465 with implicit TLS or 587 with STARTTLS. Keep credentials in deployment secrets.

# AI (optional — ReyDesk-managed provider key)
REYDESK_AI_ENABLED=false
REYDESK_AI_BASE_URL=https://api.openai.com/v1
REYDESK_AI_API_KEY=
REYDESK_AI_MODEL=gpt-4o-mini
REYDESK_AI_PROVIDER=openai_compatible
REYDESK_AI_AZURE_API_VERSION=2024-10-21
REYDESK_AI_TIMEOUT_MS=15000
# Allow private HTTP/self-hosted AI endpoints only when explicitly enabled.
# REYDESK_AI_ALLOW_PRIVATE_ENDPOINTS=false

# VAPID keys (optional — for Web Push notifications)
REYDESK_VAPID_PUBLIC_KEY=
REYDESK_VAPID_PRIVATE_KEY=
REYDESK_VAPID_SUBJECT=mailto:admin@reydesk.com

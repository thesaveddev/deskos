# DeskOS API — development environment
# Copy to .env (or export these variables). The dev-db helper (npm run dev:db)
# starts an embedded PostgreSQL matching these defaults.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Matches apps/api/scripts/dev-db.ts defaults
DATABASE_URL=postgresql://deskos:deskos_dev_only@localhost:5432/deskos

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in development, an ephemeral secret is generated at boot (tokens
# will not survive restarts). MUST be set in production.
DESKOS_JWT_SECRET=

# Key used to encrypt per-tenant IMAP channel passwords at rest (AES-256-GCM).
# Same generation rule as JWT secret. MUST be set in production.
# DESKOS_EMAIL_KEY=

# Shared HMAC secret used for short-lived technician/agent relay tickets.
# Keep this identical in apps/relay's DESKOS_RELAY_SECRET environment.
# DESKOS_RELAY_SECRET=

# Optional overrides
# DESKOS_JWT_ISSUER=deskos
# DESKOS_ACCESS_TTL_SEC=900
# DESKOS_REFRESH_TTL_DAYS=30
# DESKOS_BCRYPT_ROUNDS=10
# DESKOS_AUTO_MIGRATE=1

# Email-to-ticket (IMAP). When HOST+USER+PASS are set the poller starts
# automatically. SSL on 993 by default (set DESKOS_IMAP_TLS=false for STARTTLS).
# DESKOS_IMAP_HOST=safari.mxrouting.net
# DESKOS_IMAP_PORT=993
# DESKOS_IMAP_USER=support@example.com
# DESKOS_IMAP_PASS=secret
# DESKOS_IMAP_TLS=true
# DESKOS_IMAP_POLL_INTERVAL_SEC=60


# ReyDesk API — development environment
# Copy to .env (or export these variables). The dev-db helper (npm run dev:db)
# starts an embedded PostgreSQL matching these defaults.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Matches apps/api/scripts/dev-db.ts defaults
DATABASE_URL=postgresql://deskos:deskos_dev_only@localhost:5432/deskos

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in development, an ephemeral secret is generated at boot (tokens
# will not survive restarts). MUST be set in production.
REYDESK_JWT_SECRET=

# Key used to encrypt per-tenant IMAP channel passwords at rest (AES-256-GCM).
# Same generation rule as JWT secret. MUST be set in production.
# REYDESK_EMAIL_KEY=

# Shared HMAC secret used for short-lived technician/agent relay tickets.
# Keep this identical in apps/relay's REYDESK_RELAY_SECRET environment.
# REYDESK_RELAY_SECRET=

# Optional overrides
# REYDESK_JWT_ISSUER=deskos
# REYDESK_ACCESS_TTL_SEC=900
# REYDESK_REFRESH_TTL_DAYS=30
# REYDESK_BCRYPT_ROUNDS=10
# REYDESK_AUTO_MIGRATE=1

# Email-to-ticket (IMAP). When HOST+USER+PASS are set the poller starts
# automatically. SSL on 993 by default (set REYDESK_IMAP_TLS=false for STARTTLS).
# REYDESK_IMAP_HOST=safari.mxrouting.net
# REYDESK_IMAP_PORT=993
# REYDESK_IMAP_USER=support@example.com
# REYDESK_IMAP_PASS=secret
# REYDESK_IMAP_TLS=true
# REYDESK_IMAP_POLL_INTERVAL_SEC=60

# AI governance defaults. Tenant policy is managed in Settings → AI ticket triage.
# REYDESK_AI_ENABLED=false
# REYDESK_AI_BASE_URL=https://api.openai.com/v1
# REYDESK_AI_API_KEY=
# REYDESK_AI_MODEL=gpt-4o-mini
# REYDESK_AI_PROVIDER=openai_compatible
# REYDESK_AI_AZURE_API_VERSION=2024-10-21
# REYDESK_AI_TIMEOUT_MS=15000
# REYDESK_AI_ALLOW_PRIVATE_ENDPOINTS=false


{
  "name": "@deskos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/db/migrations';fs.mkdirSync(p,{recursive:true});fs.cpSync('src/db/migrations',p,{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@deskos/shared": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@sentry/node": "^10.70.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.0",
    "imapflow": "^1.7.0",
    "jose": "^5.6.3",
    "ldapjs": "^3.0.7",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ldapjs": "^3.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "pg-embedded": "^0.2.3",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}

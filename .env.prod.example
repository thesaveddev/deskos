# ReyDesk production environment — copy to .env.prod and fill in real values.
# .env.prod is gitignored; only this .example file is committed.
DB_PASSWORD=change-me-strong-random
JWT_SECRET=change-me-64-char-random
EMAIL_KEY=change-me-32-char-random
RELAY_SECRET=change-me-40-char-random
# Required in production: comma-separated console origins allowed at the relay WS.
RELAY_ALLOWED_ORIGINS=https://reydesk.com
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@reydesk.com

# --- Billing ---------------------------------------------------------------
REYDESK_STRIPE_SECRET_KEY=
REYDESK_STRIPE_WEBHOOK_SECRET=
# Webhook endpoint to configure in Stripe:
#   https://reydesk.com/api/v1/billing/webhooks/stripe
REYDESK_PAYSTACK_PUBLIC_KEY=
REYDESK_PAYSTACK_SECRET_KEY=
# Webhook endpoint to configure in Paystack:
#   https://reydesk.com/api/v1/billing/webhooks/paystack

# --- Object storage (attachments, chat files, recordings, avatars) --------
REYDESK_STORAGE_DRIVER=s3
REYDESK_S3_ENDPOINT=
REYDESK_S3_REGION=
REYDESK_S3_BUCKET=
REYDESK_S3_ACCESS_KEY=
REYDESK_S3_SECRET_KEY=
REYDESK_S3_PUBLIC_BASE_URL=

# --- Error tracking --------------------------------------------------------
REYDESK_SENTRY_DSN=
REYDESK_SENTRY_ENVIRONMENT=production
REYDESK_SENTRY_RELEASE=reydesk

# SMTP
SMTP_HOST=safari.mxrouting.net
SMTP_PORT=465
SMTP_USER=notifications@reydesk.com
SMTP_PASS=change-me
SMTP_FROM=ReyDesk <notifications@reydesk.com>

# AI (optional)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Remote support ICE. TURN is served by the bundled coturn container once
# these are filled: set ICE_TURN_URLS=turn:reydesk.com:3478, generate a long
# random secret, and open UDP/TCP 3478 plus 49160-49200/udp on the VPS
# firewall. Without TURN, sessions rely on direct P2P and fail across strict NATs.
ICE_STUN_URLS=stun:stun.l.google.com:19302
ICE_TURN_URLS=
ICE_TURN_SECRET=
ICE_TURN_REALM=reydesk
